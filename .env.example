# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=False

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email Configuration (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@smartpostoffice.com

# SMS Gateway - Fast2SMS
FAST2SMS_API_KEY=your-fast2sms-api-key

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id


# If you scan QR codes on a phone, localhost/127.0.0.1 won't work.
# Set this to a phone-reachable base URL (LAN IP or deployed domain).
# Examples:
#   PUBLIC_BASE_URL=http://192.168.1.20:5000
#   PUBLIC_BASE_URL=https://smartpostoffice.example.com
PUBLIC_BASE_URL=

# Optional: bind Flask to all interfaces so other devices on your network can reach it.
# FLASK_HOST=0.0.0.0
FLASK_HOST=
